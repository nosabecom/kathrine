+@androidx.annotation.OptIn(androidx.media3.common.util.UnstableApi::class)
 object SubtitleUtils {
+  private val styles = WeakHashMap<PlayerView, SubtitleStyle>()
+  private val bindings = WeakHashMap<PlayerView, Pair<Player, Player.Listener>>()
+
+  fun setCustomStyle(view: PlayerView, context: Context, style: SubtitleStyle?) {
+    if (style == null) styles.remove(view) else styles[view] = style
+    configureSubtitleView(view, context)
+  }
+
+  fun detach(view: PlayerView) {
+    bindings.remove(view)?.let { (player, listener) -> player.removeListener(listener) }
+  }
+
+  private fun positioned(view: PlayerView) {
+    val style = styles[view] ?: return
+    val cues = view.player?.currentCues?.cues ?: return
+    view.subtitleView?.setCues(cues.map { cue ->
+      if (cue.bitmap != null) cue else cue.buildUpon()
+        .setLine(1f - style.bottomPaddingFraction.coerceIn(0f, .9f), Cue.LINE_TYPE_FRACTION)
+        .setLineAnchor(Cue.ANCHOR_TYPE_END).build()
+    })
+  }
+
+  private fun color(value: String, fallback: Int): Int =
+    try { Color.parseColor(value) } catch (_: IllegalArgumentException) { fallback }
   /**
    * Configures the PlayerView's subtitle view to fix sizing issues with embedded styles.
    * Disables embedded HLS subtitle styling and applies Android accessibility settings
    * with a reasonable base font size.
    */
   fun configureSubtitleView(playerView: PlayerView, context: Context) {
+    val custom = styles[playerView]
+    if (custom != null) {
+      playerView.subtitleView?.apply {
+        setApplyEmbeddedStyles(false)
+        setApplyEmbeddedFontSizes(false)
+        setStyle(CaptionStyleCompat(
+          color(custom.foregroundColor, Color.WHITE), color(custom.backgroundColor, Color.TRANSPARENT),
+          color(custom.windowColor, Color.TRANSPARENT),
+          when (custom.edgeType) { "outline" -> CaptionStyleCompat.EDGE_TYPE_OUTLINE; "none" -> CaptionStyleCompat.EDGE_TYPE_NONE; else -> CaptionStyleCompat.EDGE_TYPE_DROP_SHADOW },
+          color(custom.edgeColor, Color.BLACK), null
+        ))
+        setFixedTextSize(TypedValue.COMPLEX_UNIT_SP, custom.fontSize.coerceIn(12f, 64f))
+        setBottomPaddingFraction(custom.bottomPaddingFraction.coerceIn(0f, .9f))
+      }
+      val player = playerView.player
+      if (bindings[playerView]?.first !== player) {
+        detach(playerView)
+        if (player != null) {
+          val reference = WeakReference(playerView)
+          val listener = object : Player.Listener {
+            override fun onCues(cueGroup: CueGroup) {
+              // PlayerView applies its own cues too. Post after all listeners so
+              // explicit source Cue.line values cannot override the user's position.
+              reference.get()?.let { view -> view.post {
+                if (view.player === player && bindings.containsKey(view)) positioned(view)
+              } }
+            }
+          }
+          player.addListener(listener)
+          bindings[playerView] = Pair(player, listener)
+        }
+      }
+      positioned(playerView)
+      return
+    }
+    detach(playerView)
     playerView.subtitleView?.apply {
       setApplyEmbeddedStyles(false)
       setApplyEmbeddedFontSizes(false)
