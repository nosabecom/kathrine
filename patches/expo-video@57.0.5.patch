+package expo.modules.video.records
+
+import android.net.Uri
+import androidx.media3.common.MediaItem
+import expo.modules.kotlin.records.Field
+import expo.modules.kotlin.records.Record
+import expo.modules.kotlin.types.OptimizedRecord
+import java.io.Serializable
+
+@OptimizedRecord
+@androidx.annotation.OptIn(androidx.media3.common.util.UnstableApi::class)
+class ExternalSubtitle(
+  @Field val uri: Uri = Uri.EMPTY,
+  @Field val language: String = "en",
+  @Field val label: String = "English",
+  @Field val id: String = "external",
+  @Field val mimeType: String = "text/vtt"
+) : Record, Serializable {
+  fun toConfiguration() = MediaItem.SubtitleConfiguration.Builder(uri)
+    .setId(id).setLanguage(language).setLabel(label).setMimeType(mimeType)
+    .setSelectionFlags(0).build()
+}
