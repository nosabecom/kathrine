[Unit]
Description=Kathrine personal media server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/kathrine/current
Environment=NODE_ENV=production
EnvironmentFile=%h/kathrine-data/server.env
ExecStart=%h/.local/bin/node dist/server/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
Nice=5
MemoryMax=1536M
TasksMax=96

[Install]
WantedBy=default.target
