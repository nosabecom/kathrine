{
  "name": "kathrine",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "scripts/import-libraries.mjs",
    "deploy"
  ],
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web 'pnpm dev:server' 'pnpm dev:web'",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node dist/server/index.js",
    "build": "node --version && tsc -p tsconfig.server.json && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && pnpm --dir apps/mobile check",
    "test": "tsx --test tests/*.test.ts",
    "test:ewaste": "bash scripts/test-ewaste.sh",
    "verify:cleanup": "node scripts/cleanup-verification.mjs",
    "android:build": "node scripts/android.mjs phone && node scripts/android.mjs tv",
    "android:phone": "node scripts/android.mjs phone",
    "android:tv": "node scripts/android.mjs tv",
    "android:lint": "node scripts/android.mjs lint",
    "mobile:dev": "pnpm --dir apps/mobile start",
    "deploy:ewaste": "bash scripts/deploy-ewaste.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.7",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
