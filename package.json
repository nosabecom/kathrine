{
  "name": "kathrine",
  "version": "0.1.0",
  "private": true,
  "files": ["dist", "scripts/import-libraries.mjs", "deploy"],
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "concurrently -k -n server,web 'pnpm dev:server' 'pnpm dev:web'",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node dist/server/index.js",
    "build": "tsc -p tsconfig.server.json && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && pnpm --dir apps/mobile check",
    "test": "tsx --test tests/*.test.ts",
    "test:ewaste": "bash scripts/test-ewaste.sh",
    "verify:cleanup": "node scripts/cleanup-verification.mjs",
    "android:build": "node scripts/android.mjs phone && node scripts/android.mjs tv",
    "android:phone": "node scripts/android.mjs phone",
    "android:tv": "node scripts/android.mjs tv",
    "android:lint": "node scripts/android.mjs lint",
    "mobile:dev": "pnpm --dir apps/mobile start",
    "deploy:ewaste": "bash scripts/deploy-ewaste.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.0.0",
    "fast-xml-parser": "^5.3.0",
    "fastify": "^5.12.7",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
